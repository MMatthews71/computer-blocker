{
  "name": "focuslock",
  "version": "0.1.0",
  "private": true,
  "description": "FocusLock — a desktop focus & distraction blocking app built as a commitment device.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "service": "npm run start --workspace @focuslock/service",
    "desktop": "npm run dev --workspace @focuslock/desktop",
    "app": "npm run electron:dev --workspace @focuslock/desktop",
    "dist:win": "npm run dist:win --workspace @focuslock/desktop"
  },
  "engines": {
    "node": ">=18"
  }
}
